# docker-compose icin ornek ortam dosyasi. Kopyalayip ".env" olarak kaydedin.
# .env git'e girmez.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=BudunsDb
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Zorunlu: uzun ve rastgele olmali.
TOKEN_SECURITY_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
VERIFICATION_CODE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

CORS_ALLOWED_ORIGIN=http://localhost:5173
CACHE_DAILY_TOP_POSTS_TTL_SECONDS=60

MAIL_USERNAME=
MAIL_PASSWORD=
SEQ_SERVER_URL=
