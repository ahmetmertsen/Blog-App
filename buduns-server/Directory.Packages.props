<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Tum NuGet surumleri bu dosyada yonetilir. csproj dosyalarinda Version
    ozniteligi bulunmaz. Surum yukseltmeleri sadece buradan yapilir.
  -->

  <ItemGroup Label="Microsoft / Framework">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.29" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.29" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="8.0.29" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!--
      Npgsql acikca sabitlendi: EF Core saglayicisi Npgsql 8.0.6 isterken Serilog
      Postgres sink'i 8.0.3 istiyor. Ikisinin ayni surumde bulusmasi sart.
    -->
    <PackageVersion Include="Npgsql" Version="8.0.6" />
    <!-- JwtBearer 8.0.29'un bagli oldugu IdentityModel surumu ile hizali. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="7.7.3" />
  </ItemGroup>

  <!--
    DIKKAT - LISANS: Asagidaki paketler sonraki ana surumlerinde ucretli
    lisansa gecti. Surum yukseltmeden once lisans kosullarini kontrol edin.
      MediatR   13.0.0+ -> ticari lisans (son Apache-2.0 surum: 12.5.0)
    Ayni durum test tarafinda FluentAssertions 8.0.0+ icin de gecerli.

    AutoMapper bagimliligi kaldirildi (elle mapping'e gecildi). Boylece
    GHSA-rvv3-g6hj-g44x ve onu susturan NoWarn NU1903 satiri da kalkti.
  -->

  <ItemGroup Label="Uygulama kutuphaneleri">
    <PackageVersion Include="FluentValidation" Version="11.12.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <PackageVersion Include="MediatR" Version="12.5.0" />
  </ItemGroup>

  <ItemGroup Label="Logging / API dokumantasyonu">
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <!--
      Serilog.Sinks.PostgreSQL 2.3.0 terk edilmis durumda ve Npgsql 5.0.5'e
      bagli; Npgsql 8 ile calismaz. Bakimi surdurulen fork'a gecildi.
    -->
    <PackageVersion Include="Serilog.Sinks.Postgresql.Alternative" Version="4.0.4" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <!--
      Swashbuckle 10.x, Microsoft.OpenApi 2.0'a gectigi icin mevcut
      OpenApiReference tabanli Swagger yapilandirmasi ile uyumlu degil.
    -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <!-- FluentAssertions 8.0.0+ ticari lisans; son ucretsiz surumde tutuluyor. -->
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.29" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
