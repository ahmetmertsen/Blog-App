<Project>

  <!-- Tum projeler icin ortak derleme ayarlari. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Nullable circiri
    ================
    Nullable temizligi faz faz ilerliyor; her kazanim geri kaymasin diye iki
    seviyede kilitleniyor:

      1) Kod bazinda - bir uyari kodu tum cozumde sifirlandiginda asagidaki
         listeye eklenir.
      2) Proje bazinda - bir projede hic nullable uyarisi kalmadiginda o
         projenin csproj'una <NullableStrict>true</NullableStrict> eklenir.

    Ikisinin WarningsAsErrors'a cevrilmesi Directory.Build.targets icinde
    yapilir; NullableStrict csproj'da tanimlandigi ve bu dosya csproj govdesinden
    once degerlendirildigi icin kosul burada calismaz.

    Tum projeler NullableStrict oldugunda 1. madde gereksizlesir ve silinir.
  -->
  <PropertyGroup>
    <!-- Faz 2'de tum cozumde sifirlandi. Geriye yalnizca CS8618 kaldi. -->
    <ClearedNullableWarnings>CS8600;CS8601;CS8602;CS8604;CS8619</ClearedNullableWarnings>
  </PropertyGroup>

</Project>
