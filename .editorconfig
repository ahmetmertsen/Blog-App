root = true

# Kaynak dosyalari UTF-8 olmak ZORUNDA. BOM'suz ANSI (Windows-1254) kaydedilen
# dosyalarda Roslyn, isletim sisteminin kod sayfasina duserek cozum yapar:
# Windows-TR'de Turkce karakterler dogru okunur, Linux'ta (CI ve Dockerfile)
# U+FFFD'ye donusur. Yani ayni kaynak, derlendigi makineye gore farkli metin
# uretir. Bu ayar editorlerin dosyalari yanlislikla ANSI kaydetmesini onler.
#
# Satir sonu LF: .gitattributes depoya ve checkout'a LF dayatiyor, bu satir da
# editorlerin yeni dosyalari CRLF ile yazmasini onluyor. Ikisi olmadan calisma
# kopyasi yeniden karisir.
[*]
charset = utf-8
end_of_line = lf
