# docker compose icin ayarlar. Kullanmadan once kopyalayin:
#   cp .env.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=BudunsDb

# HMAC-SHA256 icin en az 32 karakter olmali.
TOKEN_SECURITY_KEY=degistirin-en-az-32-karakterlik-rastgele-bir-anahtar
VERIFICATION_CODE_SECRET=degistirin-en-az-32-karakterlik-baska-bir-anahtar

CORS_ORIGIN=http://localhost:5173

# SMTP hesabi. Bos birakilirsa uygulama yine ayaga kalkar ama dogrulama ve
# sifre sifirlama mailleri gonderilemez; acilista uyari loglanir.
# Sunucu ve port appsettings.json'dan gelir (varsayilan smtp.gmail.com:587).
# Gmail kullaniyorsaniz hesap sifresi calismaz: iki adimli dogrulamayi acip
# "uygulama sifresi" (App Password) uretmeniz gerekir.
MAIL_USERNAME=
MAIL_PASSWORD=
