# docker compose icin ayarlar.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=BudunsDb

# HMAC-SHA256 icin en az 32 karakter olmali.
TOKEN_SECURITY_KEY=degistirin-en-az-32-karakterlik-rastgele-bir-anahtar
VERIFICATION_CODE_SECRET=degistirin-en-az-32-karakterlik-baska-bir-anahtar

CORS_ORIGIN=http://localhost:5173

# Redis onbellegi. Tanimli degilse varsayilanlar kullanilir.
REDIS_MAXMEMORY=256mb
CACHE_DAILY_TOP_POSTS_TTL_SECONDS=60
CACHE_ENDPOINT_PERMISSION_TTL_SECONDS=300


MAIL_USERNAME=
MAIL_PASSWORD=
